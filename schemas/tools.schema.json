{
  "$schema": "https://json-schema.org/draft-07/schema",
  "$id": "https://github.com/z451047442-debug/agency-agents/schemas/tools.schema.json",
  "title": "Agency Tool Configuration",
  "description": "Schema for tool definitions consumed by convert.sh and install.sh. Each tool specifies its output format, install destination, and file naming conventions.",
  "type": "object",
  "required": [
    "tools"
  ],
  "properties": {
    "tools": {
      "type": "object",
      "description": "Map of tool IDs to their configuration.",
      "patternProperties": {
        "^[a-z][a-z0-9-]*$": {
          "type": "object",
          "required": [
            "label",
            "format",
            "dest",
            "kebab"
          ],
          "properties": {
            "label": {
              "type": "string",
              "description": "Human-readable tool name shown in install.sh output."
            },
            "kebab": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$",
              "description": "URL-safe kebab-case identifier for the tool."
            },
            "format": {
              "type": "string",
              "enum": [
                "identity",
                "codex-toml",
                "gemini-md",
                "qwen-md",
                "cursor-mdc",
                "opencode-md",
                "skill-md",
                "aider-conventions",
                "antigravity-skill",
                "kimi-agent",
                "openclaw-workspace",
                "windsurf-rules",
                "hermes-router-plugin",
                "omc-plugin"
              ],
              "description": "Output file format / renderer contract."
            },
            "ext": {
              "type": "string",
              "description": "Output file extension (e.g. '.md', '.toml', '.mdc')."
            },
            "dest": {
              "type": "object",
              "description": "Install destination paths, keyed by scope (user/project), each value is an array of path templates.",
              "properties": {
                "user": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "project": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "split_sections": {
              "type": "boolean",
              "default": false,
              "description": "Whether to split agent body into persona/operations files (openclaw)."
            },
            "minimal_frontmatter": {
              "type": "boolean",
              "default": false,
              "description": "Whether to strip color/emoji/vibe from frontmatter (qwen, codex)."
            },
            "single_file": {
              "type": "boolean",
              "default": false,
              "description": "Whether all agents are merged into one file (aider, windsurf)."
            },
            "id": {
              "type": "string",
              "description": "Unique tool identifier (matches key)."
            },
            "short": {
              "type": "string",
              "description": "Short display label."
            },
            "accent": {
              "type": "string",
              "description": "Accent color for UI."
            },
            "icon": {
              "type": "string",
              "description": "Icon identifier for UI."
            },
            "order": {
              "type": "integer",
              "description": "Display order in UI."
            },
            "installKind": {
              "type": "string",
              "enum": [
                "per-agent",
                "roster",
                "plugin"
              ],
              "description": "Installation mechanism."
            },
            "scope": {
              "type": "string",
              "enum": [
                "user",
                "project",
                "both"
              ],
              "description": "Install scope."
            },
            "slugFrom": {
              "type": "string",
              "enum": [
                "source",
                "name"
              ],
              "description": "How to derive the slug."
            },
            "detect": {
              "type": "object",
              "description": "Detection configuration for installed tools.",
              "properties": {
                "bins": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "dirs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "version": {
              "type": "object",
              "description": "Version detection configuration.",
              "properties": {
                "bin": {
                  "type": "string"
                },
                "args": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
